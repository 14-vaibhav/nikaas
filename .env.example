# Needed only for live extraction: WebHunter (agent/hunter.py) and
# document intake (agent/intake.py, POST /api/intake). The demo scenarios
# and the whole test suite run without any of this.

# Which provider extraction/intake calls. "anthropic" (default) or
# "gemini" - Gemini works with a free Google AI Studio key, no billing
# needed. Only the key for whichever provider you pick is required.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default model (agent/gemini_client.py).
GEMINI_MODEL=
